---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeroBanner from '../components/ui/PageHeroBanner.astro';
import CTABanner from '../components/sections/CTABanner.astro';
import { pages } from '../data/placeholders';
import { formatTitle } from '../data/site';

const content = pages.reviews;
---

<BaseLayout title={formatTitle(content.title)} description={content.description}>
	<PageHeroBanner title={content.title} subtitle={content.subtitle} image={content.heroImage!} overlay="cream" />

	<section class="relative py-16 sm:py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl text-brand-black/80">
				{content.intro.map((paragraph) => <p class="mb-4">{paragraph}</p>)}
			</div>

			<div class="mt-12">
				<script
					is:inline
					type="text/javascript"
					src="https://reputationhub.site/reputation/assets/review-widget.js"
				></script>
				<iframe
					class="lc_reviews_widget"
					src="https://reputationhub.site/reputation/widgets/review_widget/UJUPo3wQaHpiZ9Rc3mdw?widgetId=6a4c197a9b316a8853d63aa6"
					frameborder="0"
					scrolling="no"
					style="min-width: 100%; width: 100%;"
					title="Client reviews"
				></iframe>
			</div>
		</div>
	</section>

	<CTABanner />
</BaseLayout>
