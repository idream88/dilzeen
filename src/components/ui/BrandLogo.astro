---
import { site } from '../../data/site';

interface Props {
	variant?: 'header' | 'mobile' | 'footer' | 'card';
	class?: string;
}

const { variant = 'header', class: className = '' } = Astro.props;

const sizeClasses = {
	header: 'w-[148px] sm:w-[168px] h-auto object-contain',
	mobile: 'w-[128px] sm:w-[140px] h-auto object-contain',
	footer: 'w-[200px] sm:max-w-[220px] h-auto object-contain',
	card: 'w-[125px] h-auto object-contain',
};

const logoAsset =
	variant === 'footer'
		? {
				src: '/images/dilzeen-butterfly-name-transparent.png',
				width: 851,
				height: 668,
			}
		: {
				src: site.logo.light.src,
				src2x: site.logo.light.src2x,
				width: 1024,
				height: 793,
			};
---

<img
	src={logoAsset.src}
	srcset={'src2x' in logoAsset ? `${logoAsset.src} 1x, ${logoAsset.src2x} 2x` : undefined}
	alt={site.logo.alt}
	width={logoAsset.width}
	height={logoAsset.height}
	class:list={[sizeClasses[variant], className]}
	loading={variant === 'header' || variant === 'mobile' ? 'eager' : 'lazy'}
	decoding="async"
/>
